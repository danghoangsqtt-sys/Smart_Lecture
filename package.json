{
  "name": "smart-lecture",
  "version": "0.9.2",
  "private": true,
  "description": "SmartLecture - Local-first LMS cho giang day: chay tren may giao vien, hoc vien truy cap qua LAN",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "build": "npm run build -w web && npm run build -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "lint": "eslint .",
    "start:app": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-smartlecture.ps1",
    "install:shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-desktop-shortcut.ps1",
    "uninstall:shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-desktop-shortcut.ps1",
    "seed:demo-quiz": "node scripts/seed-demo-quiz.mjs",
    "test:e2e": "npm run build -w server && node scripts/e2e-isolated.mjs",
    "test:browser": "npm run build && node scripts/e2e-browser-isolated.mjs",
    "bench:lan": "npm run build -w server && node scripts/lan-benchmark.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.15.0",
    "typescript-eslint": "^8.69.0"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.5": true
  }
}
